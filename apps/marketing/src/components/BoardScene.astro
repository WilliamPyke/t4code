---
import Cursor from "./Cursor.astro";
import Icon from "./Icon.astro";
---

<div
  class="board"
  role="img"
  aria-label="A Tinkjam board. Priya's sticky note is joined by a line to Maya's Claude agent, which is editing an onboarding page that changes live. Maya's note waits as a draft for Sam's Codex agent until Sam presses Send."
>
  <div class="board__bar" aria-hidden="true">
    <div class="board__title">
      <Icon name="board" />
      <span><span class="board__crumb">Product team /</span> Onboarding v2</span>
    </div>
    <div class="board__people">
      <span class="avatars">
        <span class="avatar" style="background:var(--priya)">P</span>
        <span class="avatar" style="background:var(--maya)">M</span>
        <span class="avatar" style="background:var(--sam)">S</span>
      </span>
      <span class="share">Share</span>
    </div>
  </div>

  <div class="board__canvas" aria-hidden="true">
    <div class="scene">
      <div class="s-note s-note--a anim-note">
        <p>The empty state feels cold. Can it greet people by name?</p>
        <span class="s-note__by"><span class="s-dot" style="background:var(--priya)"></span>Priya</span>
        <Cursor name="Priya" color="var(--priya)" class="cursor--priya" />
      </div>

      <div class="s-note s-note--b s-note--mint">
        <p>Check the sign-up form on small phones.</p>
        <span class="s-note__by"><span class="s-dot" style="background:var(--maya)"></span>Maya</span>
      </div>

      <div class="s-card s-agent s-agent--claude">
        <div class="s-card__head">
          <span class="agent-glyph"><Icon name="spark" /></span>
          <span><span class="s-card__name">Claude</span> <span class="s-card__owner">Maya's agent</span></span>
          <span class="status"><span class="pill pill--working"><span class="pill__dot"></span>Working</span></span>
        </div>
        <div class="s-card__body">
          <div class="chips">
            <span class="chip"><Icon name="pin" />Priya's note</span>
            <span class="chip"><Icon name="wire" />Onboarding page</span>
            <span class="chip">Sent by Maya</span>
          </div>
          <div class="stream">
            <span>Reading Priya's note and the onboarding page.</span>
            <span>The empty state should greet people by name.</span>
            <span>Updating the heading and warming up the copy.<i class="caret"></i></span>
          </div>
          <div class="tool-row">
            <Icon name="edit" />
            <span>Edited onboarding page</span>
            <span class="add">+12</span><span class="del">&minus;4</span>
          </div>
        </div>
      </div>

      <div class="s-card s-agent s-agent--codex">
        <div class="s-card__head">
          <span class="agent-glyph agent-glyph--codex"><Icon name="spark" /></span>
          <span><span class="s-card__name">Codex</span> <span class="s-card__owner">Sam's agent</span></span>
          <span class="status">
            <span class="pill pill--idle state-before">Idle</span>
            <span class="pill pill--working state-after"><span class="pill__dot"></span>Working</span>
          </span>
        </div>
        <div class="s-card__body">
          <div class="draft">
            <div class="draft__label"><Icon name="pin" />From Maya's note</div>
            <p class="draft__text">Check the sign-up form on small phones and fix anything that overflows.</p>
            <div class="draft__foot">
              <span class="draft__state">
                <span class="state-before">Waiting for Sam to press Send</span>
                <span class="state-after">Sent by Sam</span>
              </span>
              <span class="mini-btn">Edit</span>
              <span class="mini-btn mini-btn--send">
                Send
                <Cursor name="Sam" color="var(--sam)" class="cursor--sam" />
              </span>
            </div>
          </div>
          <div class="stream"><span>Opening the sign-up form at 360 pixels wide.</span></div>
        </div>
      </div>

      <div class="s-card s-artifact">
        <div class="s-card__head">
          <Icon name="page" />
          <span class="s-card__name">Onboarding page</span>
          <span class="pill pill--live"><span class="pill__dot"></span>Live</span>
        </div>
        <div class="preview">
          <div class="preview__chrome"><i></i><i></i><i></i><b></b></div>
          <div class="preview__page">
            <div class="preview__art"></div>
            <div class="preview__heading">
              <span class="heading-old">Welcome aboard</span>
              <span class="heading-new">Hi Priya, let's get you set up</span>
            </div>
            <div class="preview__text"><i style="width:92%"></i><i style="width:70%"></i></div>
            <div class="preview__steps"><i></i><i></i><i></i></div>
            <span class="preview__cta">Continue</span>
          </div>
        </div>
        <div class="s-artifact__foot">
          <span class="s-dot" style="background:var(--agent)"></span>Edited by Claude just now
        </div>
        <Cursor name="Maya" color="var(--maya)" class="cursor--maya" />
      </div>

      <svg class="wires wires--wide" viewBox="0 0 1160 640">
        <path class="w1" pathLength="1" d="M278 134C322 134 316 176 358 176"></path>
        <path class="w2" pathLength="1" d="M762 110C795 110 787 150 818 150"></path>
        <path class="w3" pathLength="1" d="M298 442C338 442 332 470 370 470"></path>
        <circle class="e1" cx="360" cy="176" r="5"></circle>
        <circle class="e2" cx="820" cy="150" r="5"></circle>
        <circle class="e3" cx="372" cy="470" r="5"></circle>
      </svg>
      <svg class="wires wires--compact" viewBox="0 0 440 520">
        <path class="w1" pathLength="1" d="M110 160C110 228 140 222 140 288"></path>
        <path class="w2" pathLength="1" d="M380 288C380 266 330 276 330 254"></path>
        <circle class="e1" cx="140" cy="290" r="5"></circle>
        <circle class="e2" cx="330" cy="252" r="5"></circle>
      </svg>
    </div>

    <div class="board__tools">
      <span><Icon name="pointer" /></span>
      <span><Icon name="note" /></span>
      <span><Icon name="wire" /></span>
      <span><Icon name="spark" /></span>
      <span><Icon name="page" /></span>
    </div>
  </div>
</div>
