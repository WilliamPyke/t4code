---
interface Props {
  name: string;
  color: string;
  class?: string;
}

const { name, color, class: className } = Astro.props;
---

<span class:list={["cursor", className]}>
  <svg viewBox="0 0 20 22" width="20" height="22" aria-hidden="true">
    <path
      d="M2 1.5v17.2l4.7-4.4 3.2 6.6 3-1.4-3.1-6.5h6.6z"
      fill={color}
      stroke="#fff"
      stroke-width="1.6"
      stroke-linejoin="round"></path>
  </svg>
  <b style={`background:${color}`}>{name}</b>
</span>
