---
import Logo from "../components/Logo.astro";
import { APP_URL, SIGN_IN_URL, SITE_NAME } from "../lib/site";
import "../styles/site.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** The nav sits on top of the page's first section (the home page's board). */
  navOver?: boolean;
}

const {
  title = "Tinkjam: your team and your AI agents on one live board",
  description = "Tinkjam is a live board where product teams and their AI agents work side by side. Everyone brings their own agent, pins notes as context, and watches pages and prototypes change as agents edit them. Free while in beta.",
  noindex = false,
  navOver = false,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL("/og.png", Astro.site);
const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // The site moved. Downloads and installers stay on both addresses; pages go to the new one.
      if (/(^|\.)trellium\.org$/.test(location.hostname)) {
        location.replace("https://tinkjam.com" + location.pathname + location.search + location.hash);
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F6F5F2" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1B1820" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/outfit-600-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Tinkjam: build beautiful things with your AI agent and your teammates"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class:list={["nav", { "nav--over": navOver }]}>
      <a class="nav__brand" href="/" aria-label="Tinkjam home"><Logo class="nav__logo" /></a>
      <nav class="nav__links" aria-label="Main">
        <a class="navlink navlink--wide" href="/changelog">What's new</a>
        <a class="navlink navlink--wide" href="/download">Download</a>
        <a class="navlink" href={SIGN_IN_URL}>Sign in</a>
        <a class="btn btn--dark" href={APP_URL}>Start a board</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="footer__brand">
        <a href="/" aria-label="Tinkjam home"><Logo class="footer__logo" /></a>
        <span>&copy; {year} Tinkjam</span>
      </div>
      <nav class="footer__links" aria-label="Footer">
        <a class="navlink" href="/changelog">What's new</a>
        <a class="navlink" href="/download">Download</a>
        <a class="navlink" href="/legal">Privacy and terms</a>
        <a class="navlink" href={SIGN_IN_URL}>Sign in</a>
      </nav>
    </footer>
  </body>
</html>
