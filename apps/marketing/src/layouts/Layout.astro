---
import Logo from "../components/Logo.astro";
import { APP_URL, SITE_NAME, UPSTREAM_REPO_URL } from "../lib/site";
import "../styles/site.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Tinkjam: your team and your AI agents on one live board",
  description = "Tinkjam is a live board where product teams and their AI agents work side by side. Everyone brings their own agent, pins notes as context, and watches pages and prototypes change as agents edit them. Free while in beta.",
  noindex = false,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL("/og.png", Astro.site);
const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // The site moved. Downloads and installers stay on both addresses; pages go to the new one.
      if (/(^|\.)trellium\.org$/.test(location.hostname)) {
        location.replace("https://tinkjam.com" + location.pathname + location.search + location.hash);
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FBF6EF" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141218" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tinkjam: a live board with sticky notes, AI agents and a page they are editing" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/" aria-label="Tinkjam home"><Logo class="brand__logo" /></a>
        <nav class="site-nav" aria-label="Main">
          <a href="/#how">How it works</a>
          <a href="/#plan">Plan</a>
          <a href="/#agents">Agents</a>
          <a href="/#teams">Teams</a>
        </nav>
        <div class="site-header__actions">
          <a class="link-quiet" href={APP_URL}>Sign in</a>
          <a class="btn btn--primary btn--small" href={APP_URL}>Start a board</a>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div class="site-footer__brand">
          <a href="/" aria-label="Tinkjam home"><Logo class="site-footer__logo" /></a>
          <p>Where your team and your agents make things together.</p>
        </div>
        <nav class="site-footer__links" aria-label="Footer">
          <a href="/#how">How it works</a>
          <a href="/#pricing">Pricing</a>
          <a href="/#faq">Questions</a>
          <a href="/changelog">Changelog</a>
          <a href="/legal">Terms and privacy</a>
        </nav>
        <p class="site-footer__fine">
          <span>&copy; {year} Tinkjam.</span>
          <span>
            Built on the open-source <a href={UPSTREAM_REPO_URL}>T3 Code</a>, used under its MIT
            licence.
          </span>
        </p>
      </div>
    </footer>
  </body>
</html>
