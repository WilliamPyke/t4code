      </div>
      <div class="faq__list">
        {
          faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
        <details>
          <summary>Is it open source?</summary>
          <p>
            Yes, at its core. Tinkjam is built on <a href={UPSTREAM_REPO_URL}>T3 Code</a>, which is
            open source under the MIT licence.
          </p>
        </details>
