# Runs the headless Tinkjam Sync in the background for this user. `tinkjam-sync-cli enable-service`
# writes and starts an equivalent unit; this copy is for installing by hand:
#   cp tinkjam-sync-cli.service ~/.config/systemd/user/ && systemctl --user enable --now tinkjam-sync-cli
# Connect the computer first by running `tinkjam-sync-cli` once in a terminal.
[Unit]
Description=Tinkjam Sync: connects this computer's agents to Tinkjam
After=network-online.target

[Service]
ExecStart=%h/.local/bin/tinkjam-sync-cli run --autostart
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
