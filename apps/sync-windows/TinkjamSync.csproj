<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8 ships with every Windows 10 and 11, so the exe needs no runtime of its own. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TinkjamSync</AssemblyName>
    <RootNamespace>TinkjamSync</RootNamespace>
    <ApplicationIcon>assets\TinkjamSync.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <VersionPrefix>0.1.1</VersionPrefix>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Tinkjam Sync</Product>
    <AssemblyTitle>Tinkjam Sync</AssemblyTitle>
    <Company>Tinkjam</Company>
    <Copyright>Tinkjam</Copyright>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\*.cs" />
  </ItemGroup>
  <!-- Outfit (OFL, licence in assets\fonts\OFL.txt), the art photo and the agents' marks travel inside the exe. -->
  <ItemGroup>
    <EmbeddedResource Include="assets\fonts\Outfit-SemiBold.ttf" LogicalName="TinkjamSync.Outfit-SemiBold.ttf" />
    <EmbeddedResource Include="assets\fonts\OFL.txt" LogicalName="TinkjamSync.OFL-Outfit.txt" />
    <EmbeddedResource Include="assets\art.jpg" LogicalName="TinkjamSync.art.jpg" />
    <EmbeddedResource Include="assets\agents\claude.png" LogicalName="TinkjamSync.agent-claude.png" />
    <EmbeddedResource Include="assets\agents\codex.png" LogicalName="TinkjamSync.agent-codex.png" />
    <EmbeddedResource Include="assets\agents\cursor.png" LogicalName="TinkjamSync.agent-cursor.png" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
