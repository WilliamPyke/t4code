{
  "name": "trellium-boards",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-28",
  // Lets a board's object see a guest's stream request end when their page closes.
  "compatibility_flags": ["enable_request_signal"],
  "account_id": "df8279c833d38dca96f9a091ca3a9219",
  "workers_dev": false,
  "routes": [{ "pattern": "boards.trellium.org", "custom_domain": true }],
  "vars": {
    // Pages that may call the board host from a browser, separated by commas.
    "ALLOWED_ORIGINS": "https://app.trellium.org,http://localhost:5733",
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOARDS", "class_name": "BoardRoom" },
      { "name": "CREATE_LIMITS", "class_name": "CreateLimit" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom", "CreateLimit"] }],
  "observability": { "enabled": true },
}
